{
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    crane.url = "github:ipetkov/crane";
  };
  outputs = { nixpkgs, crane, ... }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      # crate2nix: one derivation per crate (generated by `crate2nix generate`)
      cargoNix = pkgs.callPackage ./Cargo.nix { };
      # crane: deps in one derivation, whole workspace in another
      craneLib = crane.mkLib pkgs;
      src = craneLib.cleanCargoSource ./.;
      common = { inherit src; strictDeps = true; pname = "demo"; version = "0.1.0"; };
      cargoArtifacts = craneLib.buildDepsOnly common;
    in {
      packages.${system} = {
        default = cargoNix.workspaceMembers.demo-app.build;
        crane = craneLib.buildPackage (common // { inherit cargoArtifacts; cargoExtraArgs = "-p demo-app"; doCheck = false; });
      };
    };
}
